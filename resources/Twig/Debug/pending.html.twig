{% extends "@Berlioz-HttpCore/Twig/Debug/_main.html.twig" %}

{# No snapshot yet: no section to navigate to #}
{% block sidebar %}{% endblock %}

{% block main %}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1>
            {% if status == 'pending' %}
                Snapshot in progress
            {% else %}
                Snapshot incomplete
            {% endif %}
        </h1>
    </div>

    {% if status == 'pending' %}
        <div class="card mb-3 text-bg-dark shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="spinner-border me-4" role="status" aria-hidden="true"></div>
                <div>
                    <p class="mb-1">
                        The response has been sent
                        {%- if pending.responseTime is defined and pending.responseTime is not null %}
                            in <strong>{{ (pending.responseTime * 1000)|round(3) }} ms</strong>
                        {%- endif %}, but the request is still running (work done after the response).
                    </p>
                    <p class="mb-0 text-body-secondary">
                        This page reloads automatically once the snapshot is saved.
                    </p>
                </div>
            </div>
        </div>
    {% else %}
        <div class="card mb-3 text-bg-danger shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill fs-1 me-4"></i>
                <div>
                    <p class="mb-1">
                        The snapshot has never been saved: the process probably ended before
                        (timeout, memory limit, killed worker...).
                    </p>
                    {% if pending.responseTime is defined and pending.responseTime is not null %}
                        <p class="mb-0">
                            The response had been sent in
                            <strong>{{ (pending.responseTime * 1000)|round(3) }} ms</strong>.
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block inlineJscripts %}
    {% if status == 'pending' %}
        {% include '@Berlioz-HttpCore/Twig/Debug/_pending-reload.html.twig' %}
    {% endif %}
{% endblock %}
